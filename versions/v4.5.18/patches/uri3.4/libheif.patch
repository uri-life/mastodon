From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mina Her <minacle@live.com>
Date: Thu, 24 Sep 2026 14:18:36 +0900
Subject: [PATCH] Build libheif from source and enable HEIF support in libvips

- Add a dedicated build stage for libheif 1.23.5 with built-in codecs
- Provide its headers and libraries to the libvips build and runtime images
- Update codec dependencies to match the custom libheif build
- Enable HEIF support when configuring libvips

Rationale: Building libheif from source avoids reliance on the distribution package and its codec plugins. This makes HEIF support available in libvips and the final runtime image.

Co-authored-by: Codex <noreply@openai.com>

diff --git a/Dockerfile b/Dockerfile
index 18c2716..95ab047 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -154,11 +154,12 @@ RUN \
   shared-mime-info \
   xz-utils \
   # libvips components
+  libaom-dev \
   libcgif-dev \
+  libde265-dev \
   libexif-dev \
   libexpat1-dev \
   libgirepository1.0-dev \
-  libheif-dev \
   libhwy-dev \
   libimagequant-dev \
   libjpeg62-turbo-dev \
@@ -178,9 +179,34 @@ RUN \
   libx265-dev \
   ;
 
+# Build libheif with built-in HEIC and AVIF codecs.
+FROM build AS libheif
+
+# renovate: datasource=github-releases depName=strukturag/libheif
+ARG HEIF_VERSION=1.23.5
+ARG HEIF_URL=https://github.com/strukturag/libheif/releases/download
+
+WORKDIR /usr/local/libheif/src
+ADD ${HEIF_URL}/v${HEIF_VERSION}/libheif-${HEIF_VERSION}.tar.gz /usr/local/libheif/src/
+RUN tar xf libheif-${HEIF_VERSION}.tar.gz;
+
+WORKDIR /usr/local/libheif/src/libheif-${HEIF_VERSION}
+RUN \
+  cmake --preset release-noplugins -S . -B build \
+    -DCMAKE_INSTALL_PREFIX=/usr/local/libheif \
+    -DCMAKE_INSTALL_LIBDIR=lib \
+    -DWITH_EXAMPLES=OFF; \
+  cmake --build build --parallel "$(nproc)"; \
+  cmake --install build;
+
 # Create temporary libvips specific build layer from build layer
 FROM build AS libvips
 
+COPY --from=libheif /usr/local/libheif/include /usr/local/libheif/include
+COPY --from=libheif /usr/local/libheif/lib /usr/local/libheif/lib
+ENV PKG_CONFIG_PATH=/usr/local/libheif/lib/pkgconfig
+RUN echo /usr/local/libheif/lib > /etc/ld.so.conf.d/libheif.conf; ldconfig;
+
 # libvips version to compile, change with [--build-arg VIPS_VERSION="8.15.2"]
 # renovate: datasource=github-releases depName=libvips packageName=libvips/libvips
 ARG VIPS_VERSION=8.17.3
@@ -196,7 +222,7 @@ WORKDIR /usr/local/libvips/src/vips-${VIPS_VERSION}
 
 # Configure and compile libvips
 RUN \
-  meson setup build --prefix /usr/local/libvips --libdir=lib -Ddeprecated=false -Dintrospection=disabled -Dmodules=disabled -Dexamples=false; \
+  meson setup build --prefix /usr/local/libvips --libdir=lib -Ddeprecated=false -Dintrospection=disabled -Dmodules=disabled -Dexamples=false -Dheif=enabled; \
   cd build; \
   ninja; \
   ninja install;
@@ -293,6 +319,8 @@ RUN \
   # Install Node.js packages
   yarn workspaces focus --production @mastodon/mastodon;
 
+# Copy the source-built libheif used by libvips
+COPY --from=libheif /usr/local/libheif/lib /usr/local/lib
 # Copy libvips components into layer for precompiler
 COPY --from=libvips /usr/local/libvips/bin /usr/local/bin
 COPY --from=libvips /usr/local/libvips/lib /usr/local/lib
@@ -332,9 +360,10 @@ RUN \
   libssl3t64 \
   libyaml-0-2 \
   # libvips components
+  libaom3 \
   libcgif0 \
+  libde265-0 \
   libexif12 \
-  libheif1 \
   libhwy1t64 \
   libimagequant0 \
   libjpeg62-turbo \
@@ -368,6 +397,8 @@ COPY --from=precompiler /opt/mastodon/public/packs /opt/mastodon/public/packs
 COPY --from=precompiler /opt/mastodon/public/assets /opt/mastodon/public/assets
 # Copy bundler components to layer
 COPY --from=bundler /usr/local/bundle/ /usr/local/bundle/
+# Copy the source-built libheif used by libvips
+COPY --from=libheif /usr/local/libheif/lib /usr/local/lib
 # Copy libvips components to layer
 COPY --from=libvips /usr/local/libvips/bin /usr/local/bin
 COPY --from=libvips /usr/local/libvips/lib /usr/local/lib
