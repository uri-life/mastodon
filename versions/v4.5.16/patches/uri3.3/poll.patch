+import {
+  DEFAULT_POLL_DURATION,
+  getNearestPollDuration,
+  getPollDurationAtIndex,
+  getPollDurationIndex,
+  getPollDurationSnapPoints,
+} from '../poll_duration';
+
+describe('poll duration helpers', () => {
+  it('uses clean exponential-ish snap points by default', () => {
+    expect(getPollDurationSnapPoints()).toEqual([
+      300,
+      600,
+      900,
+      1200,
+      1800,
+      2700,
+      3600,
+      5400,
+      7200,
+      9000,
+      10800,
+      14400,
+      18000,
+      21600,
+      25200,
+      28800,
+      32400,
+      43200,
+      54000,
+      64800,
+      DEFAULT_POLL_DURATION,
+      172800,
+      259200,
+      345600,
+      432000,
+      518400,
+      604800,
+    ]);
+  });
+
+  it('clamps snap points to server-provided limits', () => {
+    expect(getPollDurationSnapPoints({ min_expiration: 1800, max_expiration: 86400 })).toEqual([
+      1800,
+      2700,
+      3600,
+      5400,
+      7200,
+      9000,
+      10800,
+      14400,
+      18000,
+      21600,
+      25200,
+      28800,
+      32400,
+      43200,
+      54000,
+      64800,
+      86400,
+    ]);
+  });
+
+  it('does not add snap points beyond the requested list even when the server allows them', () => {
+    expect(getPollDurationSnapPoints({ min_expiration: 300, max_expiration: 2592000 })).not.toContain(2592000);
+  });
+
+  it('finds the nearest snapped duration', () => {
+    expect(getNearestPollDuration(11 * 3600)).toEqual(43200);
+    expect(getNearestPollDuration(25 * 3600)).toEqual(DEFAULT_POLL_DURATION);
+  });
+
+  it('maps durations to and from slider indexes', () => {
+    const index = getPollDurationIndex(43200);
+
+    expect(index).toEqual(17);
+    expect(getPollDurationAtIndex(index)).toEqual(43200);
+  });
+});
diff --git a/app/javascript/mastodon/features/compose/util/poll_duration.js b/app/javascript/mastodon/features/compose/util/poll_duration.js
new file mode 100644
index 0000000000..0113de37eb
--- /dev/null
+++ b/app/javascript/mastodon/features/compose/util/poll_duration.js
@@ -0,0 +1,90 @@
+const SECOND = 1;
+const MINUTE = 60 * SECOND;
+const HOUR = 60 * MINUTE;
+const DAY = 24 * HOUR;
+
+export const DEFAULT_POLL_DURATION = DAY;
+export const DEFAULT_POLL_MIN_EXPIRATION = 5 * MINUTE;
+export const DEFAULT_POLL_MAX_EXPIRATION = 7 * DAY;
+
+const POLL_DURATION_SNAP_POINTS = [
+  5 * MINUTE,
+  10 * MINUTE,
+  15 * MINUTE,
+  20 * MINUTE,
+  30 * MINUTE,
+  45 * MINUTE,
+  HOUR,
+  HOUR + 30 * MINUTE,
+  2 * HOUR,
+  2 * HOUR + 30 * MINUTE,
+  3 * HOUR,
+  4 * HOUR,
+  5 * HOUR,
+  6 * HOUR,
+  7 * HOUR,
+  8 * HOUR,
+  9 * HOUR,
+  12 * HOUR,
+  15 * HOUR,
+  18 * HOUR,
+  DAY,
+  2 * DAY,
+  3 * DAY,
+  4 * DAY,
+  5 * DAY,
+  6 * DAY,
+  7 * DAY,
+];
+
+const getConfigurationValue = (configuration, key, fallback) => {
+  const value = typeof configuration?.get === 'function' ? configuration.get(key) : configuration?.[key];
+  const number = Number(value);
+
+  return Number.isFinite(number) && number > 0 ? number : fallback;
+};
+
+export const getPollDurationLimits = configuration => {
+  const minExpiration = getConfigurationValue(configuration, 'min_expiration', DEFAULT_POLL_MIN_EXPIRATION);
+  const maxExpiration = Math.max(
+    minExpiration,
+    getConfigurationValue(configuration, 'max_expiration', DEFAULT_POLL_MAX_EXPIRATION),
+  );
+
+  return { minExpiration, maxExpiration };
+};
+
+export const getPollDurationSnapPoints = configuration => {
+  const { minExpiration, maxExpiration } = getPollDurationLimits(configuration);
+  const snapPoints = POLL_DURATION_SNAP_POINTS.filter(duration => duration >= minExpiration && duration <= maxExpiration);
+
+  return snapPoints.length > 0 ? snapPoints : [DEFAULT_POLL_DURATION];
+};
+
+export const getNearestPollDuration = (expiresIn, configuration) => {
+  const snapPoints = getPollDurationSnapPoints(configuration);
+  const value = Number(expiresIn);
+  const duration = Number.isFinite(value) && value > 0 ? value : DEFAULT_POLL_DURATION;
+
+  return snapPoints.reduce((closest, snapPoint) => (
+    Math.abs(snapPoint - duration) < Math.abs(closest - duration) ? snapPoint : closest
+  ), snapPoints[0]);
+};
+
+export const getPollDurationIndex = (expiresIn, configuration) => {
+  const snapPoints = getPollDurationSnapPoints(configuration);
+  const duration = getNearestPollDuration(expiresIn, configuration);
+
+  return snapPoints.indexOf(duration);
+};
+
+export const getPollDurationAtIndex = (index, configuration) => {
+  const snapPoints = getPollDurationSnapPoints(configuration);
+  const numericIndex = Number(index);
+
+  if (!Number.isInteger(numericIndex)) {
+    return getNearestPollDuration(DEFAULT_POLL_DURATION, configuration);
+  }
+
+  return snapPoints[Math.min(Math.max(numericIndex, 0), snapPoints.length - 1)];
+};
