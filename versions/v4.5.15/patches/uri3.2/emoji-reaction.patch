new file mode 100644
index 0000000000..db99575bcb
--- /dev/null
+++ b/spec/lib/status_reaction_reach_finder_spec.rb
@@ -0,0 +1,65 @@
+# frozen_string_literal: true
+
+require 'rails_helper'
+
+RSpec.describe StatusReactionReachFinder do
+  describe '#inboxes' do
+    subject(:inboxes) { described_class.new(reaction).inboxes }
+
+    let(:reacting_account) { Fabricate(:account, username: 'alice') }
+    let(:remote_author) { Fabricate(:account, username: 'bob', domain: 'remote.example', protocol: :activitypub, inbox_url: 'https://remote.example/users/bob/inbox', shared_inbox_url: 'https://remote.example/inbox') }
+    let(:remote_follower) { Fabricate(:account, username: 'carol', domain: 'follower.example', protocol: :activitypub, inbox_url: 'https://follower.example/users/carol/inbox', shared_inbox_url: 'https://follower.example/inbox') }
+    let(:visibility) { :public }
+    let(:status) { Fabricate(:status, account: remote_author, visibility: visibility, uri: 'https://remote.example/notes/1') }
+    let(:reaction) { Fabricate(:status_reaction, account: reacting_account, status: status) }
+
+    before do
+      remote_follower.follow!(reacting_account)
+    end
+
+    it 'includes the remote status author and the reacting account remote followers' do
+      expect(inboxes)
+        .to include('https://remote.example/users/bob/inbox')
+        .and include('https://follower.example/inbox')
+    end
+
+    context 'when the remote status author is also a follower using a shared inbox' do
+      before do
+        remote_author.follow!(reacting_account)
+      end
+
+      it 'uses the shared inbox and does not also include the personal inbox' do
+        expect(inboxes)
+          .to include('https://remote.example/inbox')
+          .and not_include('https://remote.example/users/bob/inbox')
+      end
+    end
+
+    context 'when the status is local' do
+      let(:status) { Fabricate(:status, account: reacting_account, visibility: visibility) }
+
+      it 'includes the reacting account remote followers only' do
+        expect(inboxes)
+          .to contain_exactly('https://follower.example/inbox')
+      end
+    end
+
+    context 'when the status has direct visibility' do
+      let(:visibility) { :direct }
+
+      it 'does not fan out to followers' do
+        expect(inboxes)
+          .to contain_exactly('https://remote.example/users/bob/inbox')
+      end
+    end
+
+    context 'when the status has limited visibility' do
+      let(:visibility) { :limited }
+
+      it 'does not fan out to followers' do
+        expect(inboxes)
+          .to contain_exactly('https://remote.example/users/bob/inbox')
+      end
+    end
+  end
+end
