@@ -0,0 +1,108 @@
+# frozen_string_literal: true
+
+require 'rails_helper'
+
+RSpec.describe 'Status reactions', :inline_jobs do
+  let(:user) { Fabricate(:user) }
+  let(:scopes) { 'write:favourites read:accounts' }
+  let(:token) { Fabricate(:accessible_access_token, resource_owner_id: user.id, scopes: scopes) }
+  let(:headers) { { 'Authorization' => "Bearer #{token.token}" } }
+  let(:status) { Fabricate(:status) }
+
+  describe 'POST /api/v1/statuses/:status_id/react/:id' do
+    subject do
+      post "/api/v1/statuses/#{status.id}/react/%F0%9F%91%8D", headers: headers
+    end
+
+    it_behaves_like 'forbidden for wrong scope', 'read read:favourites'
+
+    it 'creates a reaction and returns updated status JSON', :aggregate_failures do
+      subject
+
+      expect(response).to have_http_status(200)
+      expect(status.status_reactions.where(account: user.account, name: '👍')).to exist
+      expect(response.parsed_body).to include(
+        id: status.id.to_s,
+        reactions_count: 1,
+        reactions: include(a_hash_including(name: '👍', count: 1, me: true))
+      )
+    end
+  end
+
+  describe 'POST /api/v1/statuses/:status_id/unreact/:id' do
+    subject do
+      post "/api/v1/statuses/#{status.id}/unreact/%F0%9F%91%8D", headers: headers
+    end
+
+    before do
+      Fabricate(:status_reaction, status: status, account: user.account)
+    end
+
+    it_behaves_like 'forbidden for wrong scope', 'read read:favourites'
+
+    it 'removes a reaction and returns optimistic status JSON', :aggregate_failures do
+      subject
+
+      expect(response).to have_http_status(200)
+      expect(status.status_reactions.where(account: user.account, name: '👍')).to_not exist
+      expect(response.parsed_body).to include(
+        id: status.id.to_s,
+        reactions_count: 0,
+        reactions: be_empty
+      )
+    end
+  end
+
+  describe 'GET /api/v1/statuses/:status_id/reactions' do
+    let(:alice) { Fabricate(:account) }
+    let(:bob) { Fabricate(:account) }
+
+    before do
+      Fabricate(:status_reaction, status: status, account: alice)
+      Fabricate(:status_reaction, status: status, account: bob, name: '😂')
+    end
+
+    it 'returns paginated reaction rows with accounts' do
+      get "/api/v1/statuses/#{status.id}/reactions", headers: headers, params: { limit: 1 }
+
+      reaction = status.status_reactions.order(id: :desc).first
+
+      expect(response)
+        .to have_http_status(200)
+        .and include_pagination_headers(
+          prev: api_v1_status_reactions_url(limit: 1, since_id: reaction.id),
+          next: api_v1_status_reactions_url(limit: 1, max_id: reaction.id)
+        )
+      expect(response.parsed_body).to contain_exactly(
+        a_hash_including(id: reaction.id.to_s, account: a_hash_including(id: bob.id.to_s))
+      )
+    end
+
+    it 'filters by emoji' do
+      get "/api/v1/statuses/#{status.id}/reactions", headers: headers, params: { emoji: '😂' }
+
+      expect(response.parsed_body).to contain_exactly(
+        a_hash_including(account: a_hash_including(id: bob.id.to_s), name: '😂')
+      )
+    end
+
+    it 'does not return blocked accounts' do
+      user.account.block!(bob)
+
+      get "/api/v1/statuses/#{status.id}/reactions", headers: headers
+
+      expect(response.parsed_body).to contain_exactly(
+        a_hash_including(account: a_hash_including(id: alice.id.to_s), name: '👍')
+      )
+    end
+
+    context 'without an oauth token' do
+      it 'returns public reaction rows' do
+        get "/api/v1/statuses/#{status.id}/reactions"
+
+        expect(response).to have_http_status(200)
+        expect(response.parsed_body.size).to eq 2
+      end
+    end
+  end
+end
