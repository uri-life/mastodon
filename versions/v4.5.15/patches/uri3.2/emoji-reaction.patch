From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mina Her <minacle@live.com>
Date: Sat, 20 Jun 2026 17:16:29 +0900
Subject: [PATCH 2/3] Enhance ActivityPub delivery for emoji reactions

- Create StatusReactionReachFinder for audience logic
- Implement fan-out delivery to followers of the reactor
- Use push_bulk for efficient delivery job processing
- Apply visibility checks to prevent privacy leakage

Rationale: Expanding the delivery scope to include followers of the reacting account ensures consistent activity visibility while maintaining privacy for direct or limited statuses.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>

diff --git a/app/lib/status_reaction_reach_finder.rb b/app/lib/status_reaction_reach_finder.rb
new file mode 100644
index 0000000000..aba580a354
--- /dev/null
+++ b/app/lib/status_reaction_reach_finder.rb
@@ -0,0 +1,32 @@
+# frozen_string_literal: true
+
+class StatusReactionReachFinder
+  # @param [StatusReaction] reaction
+  def initialize(reaction)
+    @status = reaction.status
+    @account = reaction.account
+  end
+
+  def inboxes
+    (followers_inboxes + status_author_inboxes).compact.uniq
+  end
+
+  private
+
+  def followers_inboxes
+    return @followers_inboxes if defined?(@followers_inboxes)
+
+    @followers_inboxes = if @status.direct_visibility? || @status.limited_visibility?
+                            []
+                          else
+                            @account.followers.inboxes
+                          end
+  end
+
+  def status_author_inboxes
+    return [] if @status.account.local? || !@status.account.activitypub?
+    return [] if @status.account.shared_inbox_url.present? && followers_inboxes.include?(@status.account.shared_inbox_url)
+
+    [@status.account.inbox_url]
+  end
+end
diff --git a/app/services/react_service.rb b/app/services/react_service.rb
index f0c5a435da..9bb5a4c0f6 100644
--- a/app/services/react_service.rb
+++ b/app/services/react_service.rb
@@ -35,8 +35,13 @@ class ReactService < BaseService
 
     if status.account.local?
       LocalNotificationWorker.perform_async(status.account_id, reaction.id, 'StatusReaction', 'reaction')
-    elsif status.account.activitypub?
-      ActivityPub::DeliveryWorker.perform_async(build_json(reaction), reaction.account_id, status.account.inbox_url)
+    end
+
+    inboxes = StatusReactionReachFinder.new(reaction).inboxes
+    return if inboxes.empty?
+
+    ActivityPub::DeliveryWorker.push_bulk(inboxes, limit: 1_000) do |inbox_url|
+      [build_json(reaction), reaction.account_id, inbox_url]
     end
   end
 
