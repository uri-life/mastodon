diff --git a/app/lib/markdown_formatter.rb b/app/lib/markdown_formatter.rb
new file mode 100644
index 0000000000..b9eff053d4
--- /dev/null
+++ b/app/lib/markdown_formatter.rb
@@ -0,0 +1,60 @@
+# frozen_string_literal: true
+
+class MarkdownFormatter
+  include RoutingHelper
+
+  SKIP_LINKIFY_ANCESTORS = %w(a code pre).freeze
+
+  attr_reader :text, :options
+
+  def initialize(text, options = {})
+    @text = text
+    @options = options
+  end
+
+  def to_s
+    html = text.blank? ? '' : linkify_text_nodes(sanitized_markdown)
+    html = add_quote_fallback(html) if options[:quoted_status].present?
+
+    html.html_safe # rubocop:disable Rails/OutputSafety
+  end
+
+  private
+
+  def sanitized_markdown
+    Sanitize.fragment(markdown.render(text), Sanitize::Config::MASTODON_STRICT)
+  end
+
+  def linkify_text_nodes(html)
+    fragment = Nokogiri::HTML5.fragment(html)
+
+    fragment.xpath('.//text()[normalize-space()]').each do |node|
+      next if node.ancestors.any? { |ancestor| SKIP_LINKIFY_ANCESTORS.include?(ancestor.name) }
+
+      node.replace(Nokogiri::HTML5.fragment(TextFormatter.new(node.text, options.merge(multiline: false)).to_s))
+    end
+
+    Sanitize.fragment(fragment.to_html, Sanitize::Config::MASTODON_STRICT)
+  end
+
+  def markdown
+    @markdown ||= Redcarpet::Markdown.new(
+      Redcarpet::Render::HTML.new(escape_html: true, no_images: true),
+      autolink: true,
+      fenced_code_blocks: true,
+      strikethrough: true,
+      tables: false
+    )
+  end
+
+  def add_quote_fallback(html)
+    return html if options[:quoted_status].nil?
+
+    url = ActivityPub::TagManager.instance.url_for(options[:quoted_status]) || ActivityPub::TagManager.instance.uri_for(options[:quoted_status])
+    return html if url.blank? || html.include?(url)
+
+    <<~HTML.squish
+      <p class="quote-inline">RE: #{TextFormatter.shortened_link(url)}</p>#{html}
+    HTML
+  end
+end
