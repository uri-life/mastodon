diff --git a/spec/lib/markdown_formatter_spec.rb b/spec/lib/markdown_formatter_spec.rb
new file mode 100644
index 0000000000..5440969f60
--- /dev/null
+++ b/spec/lib/markdown_formatter_spec.rb
@@ -0,0 +1,32 @@
+# frozen_string_literal: true
+
+require 'rails_helper'
+
+RSpec.describe MarkdownFormatter do
+  describe '#to_s' do
+    subject { described_class.new(text).to_s }
+
+    context 'with Markdown formatting' do
+      let(:text) { "# Heading\n\n- **bold** and _emphasis_\n- [Mastodon](https://joinmastodon.org)\n\n`code`" }
+
+      it 'renders supported Markdown as sanitized HTML', :aggregate_failures do
+        expect(subject).to include('<p><strong>Heading</strong></p>')
+        expect(subject).to include('<ul>')
+        expect(subject).to include('<strong>bold</strong>')
+        expect(subject).to include('<em>emphasis</em>')
+        expect(subject).to include('<a href="https://joinmastodon.org"')
+        expect(subject).to include('<code>code</code>')
+      end
+    end
+
+    context 'with HTML and images' do
+      let(:text) { '<script>alert("xss")</script> ![alt](https://example.com/image.png)' }
+
+      it 'escapes HTML and omits images', :aggregate_failures do
+        expect(subject).to include('&lt;script&gt;')
+        expect(subject).to_not include('<script>')
+        expect(subject).to_not include('<img')
+      end
+    end
+  end
+end
