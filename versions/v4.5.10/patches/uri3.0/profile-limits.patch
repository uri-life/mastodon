+        :ruby
+          profile_metadata_fields = @account.fields
+          last_filled_profile_metadata_field_index = profile_metadata_fields.rindex { |field| field.name.present? || field.value.present? }
+          visible_profile_metadata_fields_count = [
+            profile_metadata_fields.size,
+            last_filled_profile_metadata_field_index.nil? ? 1 : last_filled_profile_metadata_field_index + 2,
+          ].min
+          profile_metadata_field_index = -1
+
+        .profile-metadata-fields{ data: { profile_metadata_fields: true } }
+          = f.simple_fields_for :fields do |fields_f|
+            - profile_metadata_field_index += 1
+            - profile_metadata_field_hidden = profile_metadata_field_index >= visible_profile_metadata_fields_count
+            .row.profile-metadata-fields__row{ class: ('profile-metadata-fields__row--hidden' if profile_metadata_field_hidden), hidden: profile_metadata_field_hidden }
+              = fields_f.input :name, placeholder: t('simple_form.labels.account.fields.name'), input_html: { maxlength: Account::Field::MAX_CHARACTERS_LOCAL, data: { profile_metadata_field: 'name' } }
+              = fields_f.input :value, placeholder: t('simple_form.labels.account.fields.value'), input_html: { maxlength: Account::Field::MAX_CHARACTERS_LOCAL, data: { profile_metadata_field: 'value' } }
 
