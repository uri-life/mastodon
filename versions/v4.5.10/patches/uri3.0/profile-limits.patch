+      .to have_css(profile_metadata_field_row, count: 1)
+  end
+
+  it 'progressively reveals profile metadata fields', :js do
+    visit settings_profile_path
+
+    expect(page)
+      .to have_css(profile_metadata_field_row, count: 1)
+
+    account_field_labels.first.fill_in with: 'Personal Website'
+
+    expect(page)
+      .to have_css(profile_metadata_field_row, count: 2)
+
+    account_field_values[1].fill_in with: 'https://host.example/personal'
+
+    expect(page)
+      .to have_css(profile_metadata_field_row, count: 3)
+  end
+
+  it 'shows saved profile metadata fields followed by one blank field', :js do
+    account.update!(
+      fields: [
+        { 'name' => 'Personal Website', 'value' => 'https://host.example/personal' },
+        { 'name' => 'Professional Biography', 'value' => 'https://host.example/pro' },
+      ]
+    )
+
+    visit settings_profile_path
+
+    expect(page)
+      .to have_css(profile_metadata_field_row, count: 3)
+    expect(account_field_labels.map(&:value))
+      .to eq(['Personal Website', 'Professional Biography', ''])
+    expect(account_field_values.map(&:value))
+      .to eq(['https://host.example/personal', 'https://host.example/pro', ''])
+  end
+
