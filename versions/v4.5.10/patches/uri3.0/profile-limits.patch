From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mina Her <minacle@live.com>
Date: Wed, 27 May 2026 16:28:22 +0900
Subject: [PATCH] Expand profile metadata capacity and UI

- Implement progressive disclosure for profile metadata fields
- Increase maximum profile metadata fields from 4 to 12
- Extend display name limit to 120 and bio limit to 4,000
- Add event delegation to auto-reveal fields upon user input
- Update system specs to verify dynamic field visibility

Rationale: These updates accommodate richer user profiles and improve the user experience by reducing initial clutter while allowing for expanded metadata input.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>

diff --git a/app/javascript/entrypoints/public.tsx b/app/javascript/entrypoints/public.tsx
index ff6819f8ac..d7ee203e46 100644
--- a/app/javascript/entrypoints/public.tsx
+++ b/app/javascript/entrypoints/public.tsx
@@ -32,6 +32,43 @@ const messages = defineMessages({
   },
 });
 
+const profileMetadataFieldsSelector = '[data-profile-metadata-fields]';
+const profileMetadataFieldSelector =
+  'input[data-profile-metadata-field="name"], input[data-profile-metadata-field="value"]';
+const profileMetadataFieldsInputSelector = [
+  `${profileMetadataFieldsSelector} input[data-profile-metadata-field="name"]`,
+  `${profileMetadataFieldsSelector} input[data-profile-metadata-field="value"]`,
+].join(', ');
+const profileMetadataFieldRowSelector = '.profile-metadata-fields__row';
+const profileMetadataFieldRowHiddenClass =
+  'profile-metadata-fields__row--hidden';
+
+const profileMetadataFieldRowHasValue = (row: HTMLElement) =>
+  Array.from(
+    row.querySelectorAll<HTMLInputElement>(profileMetadataFieldSelector),
+  ).some((input) => input.value.length > 0);
+
+const updateProfileMetadataFieldRows = (container: Element) => {
+  const rows = Array.from(
+    container.querySelectorAll<HTMLElement>(profileMetadataFieldRowSelector),
+  );
+
+  let lastFilledIndex = -1;
+  rows.forEach((row, index) => {
+    if (profileMetadataFieldRowHasValue(row)) {
+      lastFilledIndex = index;
+    }
+  });
+
+  const rowsToShow = Math.min(rows.length, Math.max(1, lastFilledIndex + 2));
+
+  rows.forEach((row, index) => {
+    const hidden = index >= rowsToShow;
+    row.hidden = hidden;
+    row.classList.toggle(profileMetadataFieldRowHiddenClass, hidden);
+  });
+};
+
 function loaded() {
   const { messages: localeData } = getLocale();
 
@@ -145,6 +182,10 @@ function loaded() {
       );
     });
 
+  document
+    .querySelectorAll(profileMetadataFieldsSelector)
+    .forEach(updateProfileMetadataFieldRows);
+
   updateDefaultQuotePrivacyFromPrivacy(
     document.querySelector('#user_settings_attributes_default_privacy'),
   );
@@ -265,6 +306,20 @@ Rails.delegate(
   },
 );
 
+Rails.delegate(
+  document,
+  profileMetadataFieldsInputSelector,
+  'input',
+  ({ target }) => {
+    if (!(target instanceof HTMLInputElement)) return;
+
+    const container = target.closest(profileMetadataFieldsSelector);
+    if (container) {
+      updateProfileMetadataFieldRows(container);
+    }
+  },
+);
+
 Rails.delegate(document, '.input-copy input', 'click', ({ target }) => {
   if (!(target instanceof HTMLInputElement)) return;
 
