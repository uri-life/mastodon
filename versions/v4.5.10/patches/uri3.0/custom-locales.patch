 # frozen_string_literal: true
 
+module Mastodon::CustomLocaleOverrides
+  CUSTOM_LOCALE_PATTERN = 'config/locales/custom/**/*.{rb,yml}' unless const_defined?(:CUSTOM_LOCALE_PATTERN)
+
+  module BackendExtension
+    def load_translations(*filenames)
+      super.tap do
+        Mastodon::CustomLocaleOverrides.apply_non_english_overrides!(self) if filenames.empty?
+      end
+    end
+  end
+
+  class << self
+    def paths
+      Rails.root.glob(CUSTOM_LOCALE_PATTERN).map(&:to_s)
+    end
+
+    def install!(backend)
+      backend.singleton_class.prepend(BackendExtension) unless backend.singleton_class.ancestors.include?(BackendExtension)
+    end
+
+    def apply_non_english_overrides!(backend)
+      overrides = english_overrides
+      return if overrides.empty?
+
+      translations = backend.translations
+
+      I18n.available_locales.each do |locale|
+        locale = locale.to_sym
+        next if locale == :en || !translations.key?(locale)
+
+        overrides.each { |key, value| set_key!(translations[locale], key, value) }
+      end
+    end
+
+    private
+
+    def english_overrides
+      paths.each_with_object({}) do |path, overrides|
+        flatten_translations(load_locale_file(path).fetch(:en, {})).each do |key, value|
+          overrides[key] = value
+        end
+      end
+    end
+
+    def load_locale_file(path)
+      backend = I18n::Backend::Simple.new
+      backend.load_translations(path)
+      backend.translations
+    end
+
+    def flatten_translations(translations, prefix = [])
+      translations.flat_map do |key, value|
+        key_path = prefix + [key.to_sym]
+
+        value.is_a?(Hash) ? flatten_translations(value, key_path) : [[key_path, value]]
+      end
+    end
+
+    def set_key!(translations, key, value)
+      current = translations
+
+      key[0...-1].each do |segment|
+        current[segment] = current[segment].is_a?(Hash) ? current[segment].dup : {}
+
+        current = current[segment]
+      end
+
+      current[key.last] = value
+    end
+  end
+end
