+import { getAvailableLocaleNames, loadLocaleMessages } from './load_locale';
+
+type LocaleFileMap = NonNullable<Parameters<typeof loadLocaleMessages>[1]>;
+
+function localeFile(messages: Record<string, string>) {
+  return () => Promise.resolve({ default: messages });
+}
+
+describe('getAvailableLocaleNames', () => {
+  test('returns locale names from upstream locale files', () => {
+    expect(
+      getAvailableLocaleNames({
+        './en.json': localeFile({}),
+        './pt-BR.json': localeFile({}),
+      }),
+    ).toEqual(['en', 'pt-BR']);
+  });
+});
+
+describe('loadLocaleMessages', () => {
+  test('merges custom messages over upstream messages', async () => {
+    const upstreamLocales: LocaleFileMap = {
+      './en.json': localeFile({
+        'compose_form.placeholder': 'What is on your mind?',
+        'navigation_bar.home': 'Home',
+      }),
+    };
+    const customLocales: LocaleFileMap = {
+      './custom/en.json': localeFile({
+        'compose_form.placeholder': 'Custom placeholder',
+      }),
+    };
+
+    await expect(
+      loadLocaleMessages('en', upstreamLocales, customLocales),
+    ).resolves.toEqual({
+      'compose_form.placeholder': 'Custom placeholder',
+      'navigation_bar.home': 'Home',
+    });
+  });
