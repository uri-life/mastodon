+
+    await expect(
+      loadLocaleMessages('en', upstreamLocales, customLocales),
+    ).resolves.toEqual({
+      'compose_form.placeholder': 'Custom placeholder from branch B',
+      'navigation_bar.home': 'Custom home',
+    });
+  });
+
+  test('ignores custom files for other locales in nested directories', async () => {
+    const upstreamLocales: LocaleFileMap = {
+      './ko.json': localeFile({
+        'navigation_bar.home': '홈',
+      }),
+    };
+    const customLocales: LocaleFileMap = {
+      './custom/branch-a/en.json': localeFile({
+        'navigation_bar.home': 'Custom home',
+      }),
+      './custom/branch-a/ko.json': localeFile({
+        'navigation_bar.home': '커스텀 홈',
+      }),
