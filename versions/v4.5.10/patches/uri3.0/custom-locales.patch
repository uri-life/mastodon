@@ -0,0 +1,64 @@
+# frozen_string_literal: true
+
+require 'rails_helper'
+
+RSpec.describe 'Custom locale overrides' do # rubocop:disable RSpec/DescribeClass
+  let(:custom_locale_dir) { Rails.root.join('config', 'locales', 'custom') }
+  let(:custom_en_locale_file) { custom_locale_dir.join('custom_locale_spec.en.yml') }
+  let(:custom_unsupported_locale_file) { custom_locale_dir.join('custom_locale_spec.zz.yml') }
+
+  around do |example|
+    original_config_load_path = Rails.application.config.i18n.load_path.dup
+    original_i18n_load_path = I18n.load_path.dup
+    original_available_locales = Rails.application.config.i18n.available_locales.dup
+    original_default_locale = Rails.application.config.i18n.default_locale
+    custom_locale_dir_existed = custom_locale_dir.exist?
+
+    FileUtils.mkdir_p(custom_locale_dir)
+    custom_en_locale_file.write(<<~YAML)
+      en:
+        auth:
+          login: Custom login
+    YAML
+    custom_unsupported_locale_file.write(<<~YAML)
+      zz:
+        auth:
+          login: Unsupported custom login
+    YAML
+
+    Rails.application.config.i18n.load_path.unshift(custom_en_locale_file.to_s)
+    Rails.application.config.i18n.load_path.unshift(custom_unsupported_locale_file.to_s)
+
+    load Rails.root.join('config', 'initializers', 'i18n.rb')
+    I18n.load_path = Rails.application.config.i18n.load_path
+    I18n.backend.reload!
+
+    example.run
+  ensure
+    custom_en_locale_file.delete if custom_en_locale_file.exist?
+    custom_unsupported_locale_file.delete if custom_unsupported_locale_file.exist?
+    custom_locale_dir.rmdir if !custom_locale_dir_existed && custom_locale_dir.exist? && custom_locale_dir.children.empty?
+
+    Rails.application.config.i18n.load_path = original_config_load_path
+    I18n.load_path = original_i18n_load_path
+    Rails.application.config.i18n.available_locales = original_available_locales
+    I18n.available_locales = original_available_locales
+    Rails.application.config.i18n.default_locale = original_default_locale
+    I18n.default_locale = original_default_locale
+    I18n.backend.reload!
+  end
+
+  it 'loads custom locale files after upstream locale files' do
+    custom_paths = [custom_en_locale_file, custom_unsupported_locale_file].map(&:to_s).sort
+
+    expect(I18n.load_path.last(2)).to eq(custom_paths)
+  end
+
+  it 'allows custom files to override existing upstream locale keys' do
+    expect(I18n.t('auth.login', locale: :en)).to eq('Custom login')
+  end
+
+  it 'does not add unsupported custom locale codes to available locales' do
+    expect(I18n.available_locales).to_not include(:zz)
+  end
+end
