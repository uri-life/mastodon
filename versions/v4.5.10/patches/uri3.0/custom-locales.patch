+    const upstreamLocales: LocaleFileMap = {
+      './en.json': localeFile({
+        'compose_form.placeholder': 'What is on your mind?',
+        'navigation_bar.home': 'Home',
+      }),
+    };
+    const customLocales: LocaleFileMap = {
+      './custom/branch-a/en.json': localeFile({
+        'compose_form.placeholder': 'Custom placeholder',
+      }),
+      './custom/branch-b/en.json': localeFile({
+        'compose_form.placeholder': 'Custom placeholder from branch B',
+        'navigation_bar.home': 'Custom home',
+      }),
