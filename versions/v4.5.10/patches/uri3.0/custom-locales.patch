+
+export function loadServiceWorkerLocales(
+  localesPath: string,
+  customLocalesPath: string,
+) {
+  const filteredLocales: Record<string, Record<string, string>> = {};
+  const filenames = fs.readdirSync(localesPath);
+
+  filenames
+    .filter((filename) => /[a-zA-Z-]+\.json$/.exec(filename))
+    .forEach((filename) => {
+      const full = {
+        ...readLocaleFile(path.resolve(localesPath, filename)),
+        ...readCustomLocaleFiles(customLocalesPath, filename),
+      };
+      const locale = filename.split('.')[0];
+
+      if (!locale) throw new Error('Could not parse locale from filename');
+
+      const filteredLocale: Record<string, string> = {};
+
+      Object.entries(full).forEach(([key, value]) => {
+        if (KEEP_KEYS.includes(key)) {
+          filteredLocale[key] = value;
+        }
+      });
+
+      Object.entries(CUSTOM_TRANSLATIONS).forEach(([key, value]) => {
+        const translation = full[value];
+        if (translation) filteredLocale[key] = translation;
+      });
+
+      filteredLocales[locale] = filteredLocale;
+    });
+
+  return filteredLocales;
+}
+
+function readLocaleFile(localePath: string) {
+  const content = fs.readFileSync(localePath, 'utf-8');
+  return JSON.parse(content) as Record<string, string>;
+}
+
+function readCustomLocaleFiles(customLocalesPath: string, filename: string) {
+  return findCustomLocaleFiles(customLocalesPath, filename).reduce<
+    Record<string, string>
+  >(
+    (messages, localePath) => ({
+      ...messages,
+      ...readLocaleFile(localePath),
+    }),
+    {},
+  );
+}
+
+function findCustomLocaleFiles(customLocalesPath: string, filename: string) {
+  if (!fs.existsSync(customLocalesPath)) return [];
+
+  return fs
+    .readdirSync(customLocalesPath, { recursive: true, withFileTypes: true })
+    .filter((entry) => entry.isFile() && entry.name === filename)
+    .map((entry) => path.resolve(entry.parentPath, entry.name))
+    .sort();
+}
