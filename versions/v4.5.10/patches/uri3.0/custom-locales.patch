@@ -8,6 +8,67 @@ const localeLoadingSemaphore = new Semaphore(1);
 const localeFiles = import.meta.glob<{ default: LocaleData['messages'] }>([
   './*.json',
 ]);
+const customLocaleFiles = import.meta.glob<{ default: LocaleData['messages'] }>(
+  ['./custom/**/*.json'],
+);
+
+type LocaleFileMap = Record<
+  string,
+  () => Promise<{ default: LocaleData['messages'] }>
+>;
+
+const localePath = (locale: string) => `./${locale}.json`;
+
+export function getAvailableLocaleNames(locales: LocaleFileMap = localeFiles) {
+  return Object.keys(locales).map((path) =>
+    path.replace('./', '').replace('.json', ''),
+  );
+}
+
+export async function loadLocaleMessages(
+  locale: string,
+  locales: LocaleFileMap = localeFiles,
+  customLocales: LocaleFileMap = customLocaleFiles,
+) {
+  const upstreamLocalePath = localePath(locale);
+  const hasUpstreamLocale = Object.hasOwn(locales, upstreamLocalePath);
+  const resolvedLocale = hasUpstreamLocale ? locale : 'en';
+
+  const localeFile = locales[localePath(resolvedLocale)];
+
+  if (!localeFile) throw new Error('Could not load the locale JSON file');
+
+  const { default: upstreamLocaleData } = await localeFile();
+  const customLocaleData = await loadCustomLocaleMessages(
+    resolvedLocale,
+    customLocales,
+  );
+
+  return { ...upstreamLocaleData, ...customLocaleData };
+}
+
+async function loadCustomLocaleMessages(
+  locale: string,
+  customLocales: LocaleFileMap,
+) {
+  const customLocalePaths = Object.keys(customLocales)
+    .filter((path) => path.endsWith(`/${locale}.json`))
+    .sort();
+  const customLocaleFiles = await Promise.all(
+    customLocalePaths.map(async (path) => {
+      const customLocaleFile = customLocales[path];
+
+      if (!customLocaleFile)
+        throw new Error('Could not load the custom locale JSON file');
+
+      const { default: customLocaleData } = await customLocaleFile();
+
+      return customLocaleData;
+    }),
+  );
+
+  return Object.assign({}, ...customLocaleFiles) as LocaleData['messages'];
+}
 
