diff --git a/app/javascript/mastodon/components/status/hashtag_color_preview.tsx b/app/javascript/mastodon/components/status/hashtag_color_preview.tsx
new file mode 100644
index 0000000000..2ec2f11bf6
--- /dev/null
+++ b/app/javascript/mastodon/components/status/hashtag_color_preview.tsx
@@ -0,0 +1,64 @@
+import type { CSSProperties, FC } from 'react';
+
+import classNames from 'classnames';
+
+const HEX_COLOR_HASHTAG_REGEX = /^#([0-9a-fA-F]{6})$/;
+const LIGHT_COLOR_LUMINANCE_THRESHOLD = 0.179;
+
+interface HashtagColorPreviewData {
+  color: string;
+  isLight: boolean;
+}
+
+const toLinear = (channel: number) => {
+  const value = channel / 255;
+
+  return value <= 0.04045
+    ? value / 12.92
+    : Math.pow((value + 0.055) / 1.055, 2.4);
+};
+
+export const getHashtagColorPreviewData = (
+  hashtag: string,
+): HashtagColorPreviewData | undefined => {
+  const match = HEX_COLOR_HASHTAG_REGEX.exec(hashtag);
+  const hex = match?.[1];
+
+  if (!hex) {
+    return undefined;
+  }
+
+  const red = parseInt(hex.slice(0, 2), 16);
+  const green = parseInt(hex.slice(2, 4), 16);
+  const blue = parseInt(hex.slice(4, 6), 16);
+  const luminance =
+    0.2126 * toLinear(red) + 0.7152 * toLinear(green) + 0.0722 * toLinear(blue);
+
+  return {
+    color: `#${hex}`,
+    isLight: luminance > LIGHT_COLOR_LUMINANCE_THRESHOLD,
+  };
+};
+
+export const HashtagColorPreview: FC<{ hashtag: string }> = ({ hashtag }) => {
+  const preview = getHashtagColorPreviewData(hashtag);
+
+  if (!preview) {
+    return null;
+  }
+
+  const style: CSSProperties = {
+    backgroundColor: preview.color,
+  };
+
+  return (
+    <span
+      aria-hidden='true'
+      className={classNames('hashtag__color-preview', {
+        'hashtag__color-preview--light': preview.isLight,
+        'hashtag__color-preview--dark': !preview.isLight,
+      })}
+      style={style}
+    />
+  );
+};
