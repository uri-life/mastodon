+import { MemoryRouter } from 'react-router-dom';
+
+import { cleanup, render, screen } from '@testing-library/react';
+
+import { HandledLink } from '../handled_link';
+import {
+  getHashtagColorPreviewData,
+  HashtagColorPreview,
+} from '../hashtag_color_preview';
+
+const renderHandledLink = ({
+  text,
+  prevText,
+}: {
+  text: string;
+  prevText?: string;
+}) =>
+  render(
+    <MemoryRouter>
+      <HandledLink
+        href={`https://example.com/tags/${text.replace(/^#/, '')}`}
+        text={text}
+        prevText={prevText}
+        hashtagAccountId='42'
+      >
+        <span>{text}</span>
+      </HandledLink>
+    </MemoryRouter>,
+  );
+
+describe('getHashtagColorPreviewData', () => {
+  it('returns preview data for six-digit hex color hashtags', () => {
+    expect(getHashtagColorPreviewData('#000000')).toEqual({
+      color: '#000000',
+      isLight: false,
+    });
+    expect(getHashtagColorPreviewData('#FFFFFF')).toEqual({
+      color: '#FFFFFF',
+      isLight: true,
+    });
+  });
+
+  it('does not return preview data for non-six-digit color hashtags', () => {
+    expect(getHashtagColorPreviewData('#abc')).toBeUndefined();
+    expect(getHashtagColorPreviewData('#AABBCCDD')).toBeUndefined();
+    expect(getHashtagColorPreviewData('#GGGGGG')).toBeUndefined();
+    expect(getHashtagColorPreviewData('AABBCC')).toBeUndefined();
+  });
+});
+
+describe('HashtagColorPreview', () => {
+  afterEach(cleanup);
+
+  it('renders an aria-hidden swatch for color hashtags', () => {
+    const { container } = render(<HashtagColorPreview hashtag='#AABBCC' />);
+    const preview = container.querySelector('.hashtag__color-preview');
+
+    expect(preview).not.toBeNull();
+    expect(preview?.getAttribute('aria-hidden')).toBe('true');
+  });
+
+  it('does not render a swatch for shorthand colors', () => {
+    const { container } = render(<HashtagColorPreview hashtag='#abc' />);
+
+    expect(container.querySelector('.hashtag__color-preview')).toBeNull();
+  });
+});
+
+describe('HandledLink', () => {
+  afterEach(cleanup);
+
+  it('renders a color preview for six-digit color hashtags', () => {
+    renderHandledLink({ text: '#AABBCC' });
+
+    const link = screen.getByRole('link', { name: '#AABBCC' });
+
+    expect(link.getAttribute('href')).toBe('/tags/AABBCC');
+    expect(link.getAttribute('rel')).toBe('tag');
+    expect(link.getAttribute('data-menu-hashtag')).toBe('42');
+    expect(link.querySelector('.hashtag__color-preview')).not.toBeNull();
+  });
+
+  it('renders a color preview for split hashtag text', () => {
+    renderHandledLink({ text: 'AABBCC', prevText: '#' });
+
+    const link = screen.getByRole('link', { name: 'AABBCC' });
+
+    expect(link.getAttribute('href')).toBe('/tags/AABBCC');
+    expect(link.querySelector('.hashtag__color-preview')).not.toBeNull();
+  });
+
+  it('does not render a color preview for shorthand colors', () => {
+    renderHandledLink({ text: '#abc' });
+
+    const link = screen.getByRole('link', { name: '#abc' });
+
+    expect(link.getAttribute('href')).toBe('/tags/abc');
+    expect(link.querySelector('.hashtag__color-preview')).toBeNull();
+  });
+
+  it('does not render a color preview for non-color hashtags', () => {
+    renderHandledLink({ text: '#notacolor' });
+
+    const link = screen.getByRole('link', { name: '#notacolor' });
+
+    expect(link.querySelector('.hashtag__color-preview')).toBeNull();
+  });
+});
